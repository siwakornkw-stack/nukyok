# ---- Database ----
DATABASE_URL="postgresql://dev@localhost:5434/nukyok?schema=public"

# Secrets are blank on purpose (blank = refused / off): make each one with  openssl rand -hex 32
# (in production one under 16 characters, holding "change-me" or starting with "dev-" counts as blank; a blank or weak
# SESSION_SECRET, CRON_SECRET or EXPRESS_SYNC_SECRET there fails /api/health, so deploy.sh rolls the release back)
# ---- Session cookie (16+ characters): openssl rand -hex 32 ----
SESSION_SECRET=""

# Public https origin of this app (links in LINE messages when there is no LIFF id)
APP_URL="http://localhost:3000"

# Local testing only: log in as any user on /login without LINE (ignored in production); npm run db:seed needs "1"
DEV_LOGIN="0"

# ---- Files (photos, slips, quotations, bills) ----
# Relative only on a dev PC. Server: an absolute folder outside the release (/home/ubuntu/nukyok-data/uploads);
# the app and deploy/backup-db.sh refuse a relative one there (it would sit in a release that deploys remove).
UPLOAD_DIR="./var/uploads"

# ---- LINE ----
# LINE Login channel (LIFF app, scopes openid + profile). LIFF endpoint URL = <APP_URL>/liff
LIFF_ID=""
LINE_LOGIN_CHANNEL_ID=""
# Messaging API channel of the LINE OA (push messages, webhook /api/line/webhook).
# Channel id + secret are enough: the app issues itself 15-minute tokens. A long-lived
# LINE_CHANNEL_ACCESS_TOKEN is optional (used instead when set).
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# LINE group of the Office (type "id" in the group to get it); blank = every Office user
LINE_OFFICE_GROUP_ID=""
# LINE user ids made active Office users on first login (type "id" to the OA to get yours)
ADMIN_LINE_USER_IDS=""
# Rich menu id per role (made in LINE OA Manager / Messaging API); blank = not linked
LINE_RICHMENU_DRIVER=""
LINE_RICHMENU_FILLER=""
LINE_RICHMENU_OFFICE=""
LINE_RICHMENU_EXEC=""
LINE_RICHMENU_PURCHASING=""
LINE_RICHMENU_ACCOUNTING=""

# ---- Cron (/api/cron/<job>, Bearer CRON_SECRET; deploy/*.sh call it on 127.0.0.1, nginx keeps it closed outside) ----
# openssl rand -hex 32
CRON_SECRET=""
# Fill not done after this many minutes: remind the fillers again (every this many minutes)
FUEL_REMIND_MINUTES="30"
# Bangkok hour after which a driver still clocked in gets "ยังไม่ออกงาน"
ATTENDANCE_END_HOUR="18"
# Service due warning: this many engine hours before the interval is reached
PM_WARN_HOURS="50"

# ---- Google Sheets (read-only view): the =IMPORTDATA formulas (one token per kind, made from EXPORT_SECRET) are on the
# Office home page. openssl rand -hex 32 (blank or weak = no export; the home page says so when it is weak); a new
# value, never the old EXPORT_TOKEN, which older sheet formulas showed. Changing it stops every formula: copy the new
# ones from the home page. ----
EXPORT_SECRET=""

# ---- Express Accounting ----
# Shared secret between this app and scripts/express-agent.mjs on the office PC (same value on both): openssl rand -hex 32
EXPRESS_SYNC_SECRET=""
# The Express company the office agent must work on: its EXPRESS_DIR folder name, e.g. DHEWA66. The agent names its
# company on every call and another one (a TESTR3 test install of the live zip) is refused. Blank = not checked.
# Set it only once the office PC runs an agent that names it: an older one is refused (409) on every call.
EXPRESS_COMPANY=""

# ---- Slip reader (filler form): Google AI Studio API key; blank = the filler types the numbers ----
GEMINI_API_KEY=""
# Model override when Google retires the default (gemini-3.5-flash-lite)
GEMINI_MODEL=""
# This company's own 13-digit tax ID: a slip whose buyer tax ID was read and differs gets a flag. Blank = not compared.
COMPANY_TAX_ID=""
